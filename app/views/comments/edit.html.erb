<h1>Edit Comment</h1>
<%= form_with model: @comment, local: true do |f| %>
  <div>
    <%= f.label :content %><br>
    <%= f.text_area :content, rows: 3 %>
  </div>
  <div>
    <%= f.submit "Update Comment" %>
  </div>
<% end %>

<%= link_to "← Back to Comments", comments_path %> |
<%= link_to "← Back to Task",     task_path(@comment.task) %>