<% if @project %>
  <h1>Tasks for “<%= @project.title %>”</h1>
<% else %>
  <h1>All Your Tasks</h1>
<% end %>
<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Priority</th>
      <th>Project</th>
      <th>Done</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |t| %>
      <tr>
        <td><%= link_to t.title, task_path(t) %></td>
        <td><%= t.priority.titleize %></td>
        <td><%= link_to t.project.title, project_path(t.project) %></td>
        <td><%= t.done? ? "✅" : "❌" %></td>
        <td>
          <%= link_to "Edit",  edit_task_path(t) %> |
          <%= button_to "Delete", task_path(t.project, t), method: :delete, data: { confirm: "Delete?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>