<h1>Your Projects</h1>
<%= link_to "New Project", new_project_path %>
<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Created</th>
      <th>Tasks</th>
      <th>Actions</th>
  </tr>
  </thead>
  <tbody>
    <% @projects.each do |p| %>
      <tr>
        <td><%= link_to p.title, p %></td>
        <td><%= p.created_at.to_date %></td>
        <td><%= p.tasks.count %></td>
        <td>
          <%= link_to "Show",  p %> |
          <%= link_to "Edit",  edit_project_path(p) %> |
          <%= button_to "Delete", p, method: :delete, data: { confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
